# Copie este arquivo para .env e substitua todos os valores sensíveis.
# Use aspas simples no hash bcrypt para preservar os caracteres $.
API_KEY=SUBSTITUA_POR_OPENSSL_RAND_HEX_32
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='$2a$14$SUBSTITUA_PELO_HASH_GERADO_COM_CADDY'
APP_PORT=8182
JOB_DELAY_SECONDS=1

# Apenas para docker-compose.public.yml (VPS dedicada + DNS apontado):
APP_DOMAIN=orchestrator.exemplo.com
